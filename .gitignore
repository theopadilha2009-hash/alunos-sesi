# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...menos o exemplo, que é justamente o que documenta as chaves pro time.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# dotcontext runtime state
.context/plans/
.context/cache/semantic/
.context/runtime/
.context/**/archive/

# harness local ao clone: sessões criam worktrees em .claude/worktrees/, cada
# um com a árvore inteira do repo e node_modules symlinkado. Um `git add -A`
# ali dentro commitaria clones de si mesmo.
.claude/

