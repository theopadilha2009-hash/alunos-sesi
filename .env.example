# alunos-sesi — só os NOMES das chaves vão para o git.
# Os valores vivem no .env.local (gitignored) e no painel da Vercel.
# Projeto Supabase: adzauecsqoxgnvidrcfm (org Templates, sa-east-1)

# Supabase — painel > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Conexão direta do banco, usada só pelo scripts/db-query.sh
SUPABASE_DB_URL=

# A chave do link secreto do ADM: /adm/<ADM_CHAVE>.
# Trocar este valor invalida os crachás já emitidos e os votos por cookie.
ADM_CHAVE=

# Deploy por CLI (skill vamoo-infra). Nunca é lido pelo app.
VERCEL_TOKEN=
