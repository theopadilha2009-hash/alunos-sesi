# alunos-sesi — só os NOMES das chaves vão para o git.
# Os valores vivem no .env.local (gitignored) e no painel da Vercel.
# Projeto Supabase: adzauecsqoxgnvidrcfm (org Templates, sa-east-1)

# Supabase — painel > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Conexão direta do banco, usada só pelo scripts/db-query.sh
SUPABASE_DB_URL=

# A chave do link secreto do ADM: /adm/<ADM_CHAVE>.
# Serve SÓ para isso. Não é mais o segredo de assinatura das sessões.
# Trocar este valor apenas troca a URL do link do painel.
ADM_CHAVE=

# Segredo mestre que assina os cookies sesi.visitante / sesi.adm / sesi.usuario.
# Cada um recebe uma subchave HKDF diferente, então um token de um domínio não
# vale no outro. Gere com: openssl rand -hex 32
#
# Trocar este valor derruba TODAS as sessões ativas: todo mundo loga de novo e
# os votos anônimos ganham id novo (quem já estrelou pode estrelar outra vez,
# e alunos.estrelas não volta atrás).
SESSAO_SEGREDO=

# Deploy por CLI (skill vamoo-infra). Nunca é lido pelo app.
VERCEL_TOKEN=
